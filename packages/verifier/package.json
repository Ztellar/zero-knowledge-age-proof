{
  "name": "zkage-verifier",
  "version": "0.1.0",
  "description": "Verify post-quantum proofs of age made from a Chilean ID card, from your own server",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ztellar/zero-knowledge-age-proof.git",
    "directory": "packages/verifier"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
